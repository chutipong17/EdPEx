generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        Int    @id @unique @map("id") @db.Int
  status    String @map("status")         @db.VarChar(255)

  @@map("health_check")
}

model MonthOfDelivery {
  id      Int    @id @unique @map("id") @db.Int
  name    String @map("name")           @db.NVarChar(20)
  value   String @map("value")          @db.Char(2)

  kpi     Kpi[]

  @@map("month_of_delivery")
}

model Permission {
  id              Int    @id @unique @map("id")          @db.Int
  permissionCode  String @unique @map("permission_code") @db.VarChar(200)
  permissionName  String @map("permission_name")         @db.VarChar(200)

  rolePermission  RolePermission[]

  @@map("permission")
}

model Role {
  id          Int    @id @unique @map("id")    @db.Int
  roleCode    String @unique @map("role_code") @db.VarChar(100)
  roleNameEn  String @map("role_name_en")      @db.VarChar(100)
  roleNameTH  String @map("role_name_th")      @db.NVarChar(150)

  rolePermission RolePermission[]

  @@map("role")
}

model RolePermission {
  id           Int @id @unique @default(autoincrement()) @map("id") @db.Int
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")
  userId       Int @map("user_id")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  createdBy    String    @map("created_by") @db.NVarChar(255)
  updatedBy    String?   @map("updated_by") @db.NVarChar(255)

  role         Role @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  user         User @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([roleId], name: "idx_role_id")
  @@index([permissionId], name: "idx_permission_id")
  @@index([userId], name: "idx_user_id")

  @@map("role_permission")
}

model TargetCondition {
  id            Int    @id @unique @map("id") @db.Int
  conditionName String @map("condition_name")  @db.VarChar(5)
  description   String @map("description")     @db.NVarChar(255)

  kpi           Kpi[]

  @@map("target_condition")
}

model Organization {
  id                Int       @id @unique @map("id")            @db.Int
  organizationCode  String    @unique @map("organization_code") @db.VarChar(100)
  organizationName  String    @map("organization_name")         @db.NVarChar(255)
  isDeleted         Boolean   @default(false) @map("is_deleted")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  createdBy         String    @map("created_by")                @db.NVarChar(255)
  updatedBy         String?   @map("updated_by")                @db.NVarChar(255)

  department        Department[]

  @@map("organization")
}

model Department {
  id              Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  organizationId  Int       @map("organization_id")
  departmentCode  String?   @map("department_code") @db.VarChar(100)
  departmentName  String    @map("department_name")         @db.NVarChar(255)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  createdBy       String    @map("created_by")              @db.NVarChar(255)
  updatedBy       String?   @map("updated_by")              @db.NVarChar(255)

  organization    Organization @relation(fields: [organizationId], references: [id])

  user            User[]
  kpiTarget       KpiTarget[]

  @@index([organizationId], name: "idx_organization_id")

  @@map("department")
}

model KpiCategory {
  id            Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  categoryName  String    @map("category_name")  @db.NVarChar(255)
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  createdBy     String    @map("created_by")     @db.NVarChar(255)
  updatedBy     String?   @map("updated_by")     @db.NVarChar(255)

  kpi           Kpi[]

  @@map("kpi_category")
}

model Frequency {
  id            Int       @id @unique @map("id") @db.Int
  frequencyName String    @map("frequency_name")  @db.NVarChar(255)
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  createdBy     String    @map("created_by")     @db.NVarChar(255)
  updatedBy     String?   @map("updated_by")     @db.NVarChar(255)

  kpi           Kpi[]

  @@map("frequency")
}

model Kpi {
  id                Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  kpiCategoryId     Int       @map("kpi_category_id")
  monthOfDeliveryId Int       @map("month_of_delivery_id")
  frequencyId       Int       @map("frequency_id")
  targetConditionId Int       @map("target_condition_id")
  kpiCode           String    @map("kpi_code")     @db.VarChar(255)
  kpiName           String    @map("kpi_name")     @db.NVarChar(255)
  description       String?   @map("description")  @db.NVarChar(Max)
  unit              String    @map("unit")         @db.VarChar(100)
  year              Int       @map("year")
  targetValue       Decimal   @map("target_value") @db.Decimal(5, 2)
  isActive          Boolean   @default(false) @map("is_active")
  remark            String?   @map("remark")       @db.NVarChar(Max)
  isDeleted         Boolean   @default(false) @map("is_deleted")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  createdBy         String    @map("created_by")   @db.NVarChar(255)
  updatedBy         String?   @map("updated_by")   @db.NVarChar(255)

  kpiCategory       KpiCategory @relation(fields: [kpiCategoryId], references: [id])
  frequency         Frequency   @relation(fields: [frequencyId], references: [id])
  monthOfDelivery   MonthOfDelivery @relation(fields: [monthOfDeliveryId], references: [id])
  targetCondition   TargetCondition @relation(fields: [targetConditionId], references: [id])

  kpiComparison     KpiComparison[]
  kpiTarget         KpiTarget[]
  kpiAssignment     KpiAssignment[]

  @@index([kpiCategoryId], name: "idx_kpi_category_id")
  @@index([monthOfDeliveryId], name: "idx_month_of_delivery_id")
  @@index([frequencyId], name: "idx_frequency_id")
  @@index([targetConditionId], name: "idx_target_condition_id")

  @@map("kpi")
}

model KpiComparison {
  id        Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  kpiId     Int       @map("kpi_id")
  seq       Int       @map("seq")
  name      String?   @map("name")       @db.NVarChar(255)
  result    String?   @map("result")     @db.NVarChar(255)
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  createdBy String    @map("created_by") @db.NVarChar(255)
  updatedBy String?   @map("updated_by") @db.NVarChar(255)

  kpi       Kpi   @relation(fields: [kpiId], references: [id])

  @@index([kpiId], name: "idx_kpi_id")

  @@map("kpi_comparison")
}

model KpiTarget {
  id           Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  kpiId        Int       @map("kpi_id")
  userId       Int       @map("user_id")
  departmentId Int       @map("department_id")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  createdBy    String    @map("created_by") @db.NVarChar(255)
  updatedBy    String?   @map("updated_by") @db.NVarChar(255)

  kpi          Kpi        @relation(fields: [kpiId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([kpiId], name: "idx_kpi_id")
  @@index([userId], name: "idx_user_id")
  @@index([departmentId], name: "idx_department_id")

  @@map("kpi_target")
}

model User {
  id           Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  departmentId Int?      @map("department_id")
  firstName    String    @map("first_name") @db.NVarChar(255)
  lastName     String?   @map("last_name")  @db.NVarChar(255)
  email        String    @map("email")      @db.VarChar(255)
  mobileNumber String?   @map("mobile_number") @db.VarChar(20)
  isActive     Boolean   @default(false) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  createdBy    String    @map("created_by") @db.NVarChar(255)
  updatedBy    String?   @map("updated_by") @db.NVarChar(255)

  department   Department? @relation(fields: [departmentId], references: [id])

  kpiTarget      KpiTarget[]
  auth           Auth[]
  refreshToken   RefreshToken[]
  kpiAssignment  KpiAssignment[]
  approval       Approval[]
  notification   Notification[]
  applicationLog ApplicationLog[]
  rolePermission RolePermission[]

  @@index([departmentId], name: "idx_department_id")

  @@map("user")
}

model Auth {
  id        Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  userId    Int       @map("user_id")
  username  String    @unique @map("username") @db.VarChar(255)
  password  String    @map("password")
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  createdBy String    @map("created_by") @db.NVarChar(255)
  updatedBy String?   @map("updated_by") @db.NVarChar(255)

  user      User       @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_user_id")

  @@map("auth")
}

model RefreshToken {
  id         Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  userId     Int       @unique @map("user_id")
  token      String    @map("token")
  expiryDate DateTime  @map("expiry_date")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  createdBy  String    @map("created_by") @db.NVarChar(255)
  updatedBy  String?   @map("updated_by") @db.NVarChar(255)

  user       User      @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_user_id")

  @@map("refresh_token")
}

model KpiAssignment {
  id           Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  userId       Int       @map("user_id")
  kpiId        Int       @map("kpi_id")
  assignedDate DateTime  @map("assigned_date")
  dueDate      DateTime? @map("due_date")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  createdBy    String    @map("created_by") @db.NVarChar(255)
  updatedBy    String?   @map("updated_by") @db.NVarChar(255)

  user         User      @relation(fields: [userId], references: [id])
  kpi          Kpi       @relation(fields: [kpiId], references: [id])

  kpiSubmission KpiSubmission[]

  @@index([userId], name: "idx_user_id")
  @@index([kpiId], name: "idx_kpi_id")

  @@map("kpi_assignment")
}

model KpiSubmissionStatus {
  id          Int    @id @unique @map("id") @db.Int
  name        String @map("name")           @db.NVarChar(100)
  description String @map("description")    @db.NVarChar(255)

  kpiSubmission KpiSubmission[]

  @@map("kpi_submission_status")
}

model KpiSubmission {
  id                 Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  kpiAssignmentId    Int       @map("kpi_assignment_id")
  statusId           Int?      @map("status_id")
  submittedBy        String?   @map("submitted_by")        @db.NVarChar(100)
  submittedDate      DateTime? @map("submitted_date")
  description        String?   @map("description")         @db.NVarChar(Max)
  actualValue        Decimal?  @map("actual_value")        @db.Decimal(5, 2)
  calculatedScore    Decimal?  @map("calculated_score")    @db.Decimal(5, 2)
  achievementPercent Decimal?  @map("achievement_percent") @db.Decimal(5, 2)
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")
  createdBy          String    @map("created_by") @db.NVarChar(255)
  updatedBy          String?   @map("updated_by") @db.NVarChar(255)

  status             KpiSubmissionStatus? @relation(fields: [statusId], references: [id])
  kpiAssignment      KpiAssignment @relation(fields: [kpiAssignmentId], references: [id])

  attachment         Attachment[]
  approval           Approval[]

  @@index([kpiAssignmentId], name: "idx_kpi_assignment_id")
  @@index([statusId], name: "idx_status_id")

  @@map("kpi_submission")
}

model Attachment {
  id              Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  kpiSubmissionId Int       @map("kpi_submission_id")
  fileName        String    @map("file_name")  @db.NVarChar(200)
  filePath        String    @map("file_path")
  mimeType        String    @map("mime_type")  @db.VarChar(100)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  createdBy       String    @map("created_by") @db.NVarChar(255)
  updatedBy       String?   @map("updated_by") @db.NVarChar(255)

  kpiSubmission      KpiSubmission @relation(fields: [kpiSubmissionId], references: [id])

  @@index([kpiSubmissionId], name: "idx_kpi_submission_id")

  @@map("attachment")
}

model Approval {
  id               Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  kpiSubmissionId  Int       @map("kpi_submission_id")
  approverId       Int       @map("approver_id")
  approvalStatusId Int       @map("approval_status_id")
  approvedDate     DateTime  @map("approved_date")
  remark           String?   @map("remark")              @db.NVarChar(Max)
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  createdBy        String    @map("created_by") @db.NVarChar(255)
  updatedBy        String?   @map("updated_by") @db.NVarChar(255)

  kpiSubmission    KpiSubmission  @relation(fields: [kpiSubmissionId], references: [id])
  approver         User           @relation(fields: [approverId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  approvalStatus   ApprovalStatus @relation(fields: [approvalStatusId], references: [id])

  @@index([kpiSubmissionId], name: "idx_kpi_submission_id")
  @@index([approverId], name: "idx_approver_id")
  @@index([approvalStatusId], name: "idx_approval_status_id")

  @@map("approval")
}

model ApprovalStatus {
  id         Int    @id @unique @map("id") @db.Int
  statusName String @map("status_name")    @db.NVarChar(200)
  value      String @map("value")          @db.VarChar(200)

  approval   Approval[]

  @@map("approval_status")
}

model NotificationTemplate {
  id           Int    @id @unique @map("id") @db.Int
  templateName String @map("template_name")  @db.NVarChar(Max)
  subject      String @map("subject")        @db.NVarChar(Max)
  body         String @map("body")           @db.NVarChar(Max)

  notification Notification[]

  @@map("notification_template")
}

model Notification {
  id         Int     @id @unique @default(autoincrement()) @map("id") @db.Int
  userId     Int     @map("user_id")
  templateId Int     @map("template_id")
  title      String? @map("template_name")  @db.NVarChar(Max)
  message    String? @map("subject")        @db.NVarChar(Max)

  user    User  @relation(fields: [userId], references: [id])
  template NotificationTemplate @relation(fields: [templateId], references: [id])

  @@index([userId], name: "idx_user_id")
  @@index([templateId], name: "idx_template_id")

  @@map("notification")
}

model ApplicationLog {
  id         Int       @id @unique @default(autoincrement()) @map("id") @db.Int
  userId     Int       @map("user_id")
  moduleName String    @map("module_name")    @db.VarChar(255)
  actionType String    @map("action_type")    @db.VarChar(255)
  request    String?   @map("template_name")  @db.NVarChar(Max)
  response   String?   @map("subject")        @db.NVarChar(Max)
  isDeleted  Boolean   @default(false) @map("is_deleted")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  createdBy  String    @map("created_by")     @db.NVarChar(255)
  updatedBy  String?   @map("updated_by")     @db.NVarChar(255)

  user    User  @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_user_id")

  @@map("application_log")
}
